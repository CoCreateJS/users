{
  "name": "@cocreate/users",
  "version": "1.50.0",
  "description": "A simple users component in vanilla javascript. Easily configured using HTML5 attributes and/or JavaScript API.",
  "keywords": [
    "users",
    "low-code",
    "realtime",
    "realtime-framework",
    "collaboration",
    "shared-editing",
    "html5-framework",
    "javascript-framework"
  ],
  "publishConfig": {
    "access": "public"
  },
  "cocreate": {
    "environment": [
      "client",
      "server"
    ],
    "interface": {
      "schemaVersion": 1,
      "summary": "A simple users component in vanilla javascript. Easily configured using HTML5 attributes and/or JavaScript API.",
      "client": {
        "source": "src/client.js",
        "declarative": {
          "attributes": [
            {
              "name": "actions"
            },
            {
              "name": "session"
            },
            {
              "name": "user-status"
            }
          ],
          "selectors": [
            "[actions*=\"signUp\"]",
            "[actions*=\"signIn\"]",
            "[actions*=\"signOut\"]",
            "[actions*=\"inviteUser\"], [actions*=\"acceptInvite\"]",
            "[actions*=\"forgotPassword\"], [actions*=\"resetPassword\"]"
          ]
        },
        "api": {
          "exports": [
            "default"
          ]
        }
      },
      "server": {
        "source": "src/server.js",
        "api": {
          "exports": [
            "default"
          ]
        }
      }
    }
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/cocreatejs/CoCreate-users.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-users/issues"
  },
  "homepage": "https://cocreate.app/docs/users",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/server.js",
  "browser": "./src/client.js",
  "exports": {
    ".": {
      "node": "./src/server.js",
      "deno": "./src/server.js",
      "browser": "./src/client.js",
      "default": "./src/server.js"
    }
  },
  "dependencies": {
    "@cocreate/actions": "^1.24.0",
    "@cocreate/config": "^1.21.0",
    "@cocreate/crud-client": "^1.37.0",
    "@cocreate/element-prototype": "^1.35.0",
    "@cocreate/elements": "^1.46.0",
    "@cocreate/local-storage": "^1.20.0",
    "@cocreate/render": "^1.51.0",
    "@cocreate/server": "^1.11.0"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.9.0"
  },
  "allowScripts": {
    "@cocreate/actions@1.21.4": true,
    "@cocreate/api@1.22.5": true,
    "@cocreate/config@1.13.4": true,
    "@cocreate/crud-client@1.34.6": true,
    "@cocreate/element-prototype@1.31.4": true,
    "@cocreate/elements@1.42.9": true,
    "@cocreate/filter@1.33.6": true,
    "@cocreate/indexeddb@1.23.4": true,
    "@cocreate/local-storage@1.16.5": true,
    "@cocreate/observer@1.19.0": true,
    "@cocreate/organizations@1.30.1": true,
    "@cocreate/render@1.46.1": true,
    "@cocreate/socket-client@1.40.5": true,
    "@cocreate/utils@1.42.2": true,
    "@cocreate/webpack@1.4.3": true
  }
}
